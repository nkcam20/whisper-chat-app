rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is a member of the chat
    function isMember(chatId) {
      return isAuthenticated() && 
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.members;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.members || 
        // Allow adding lastMessage/updatedAt if member
        request.auth.uid in request.resource.data.members
      );
      
      // Messages Sub-collection
      match /messages/{messageId} {
        allow read: if isMember(chatId);
        allow create: if isMember(chatId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isMember(chatId) && (
          // Allow updating status (delivered/seen)
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        );
      }

      // Calls Sub-collection
      match /calls/{callId} {
        allow read, write: if isMember(chatId);
        
        match /callerCandidates/{candidateId} { allow read, write: if isMember(chatId); }
        match /calleeCandidates/{candidateId} { allow read, write: if isMember(chatId); }
      }
    }
  }
}
