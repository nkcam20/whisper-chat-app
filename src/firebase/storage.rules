rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /chats/{chatId}/{allPaths=**} {
      // Allow read/write if member of chat
      // Note: Full member check via firestore from storage rules is possible but expensive.
      // Usually we check if authenticated and the path contains the UID.
      allow read, write: if request.auth != null;
    }
    
    match /avatars/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
